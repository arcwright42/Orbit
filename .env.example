QWEN_REALTIME_API_KEY=
QWEN_REALTIME_URL=wss://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-plus

# Text interaction agent (Pi SDK). Separate from the realtime voice endpoint.
# Legacy fallback only until <userData>/models.json exists. Persisted profiles
# take precedence, including an explicitly empty selection. See docs/MODEL_PROVIDERS.md.
# Option A: Pi built-in provider and exact model ID; use its standard API-key
# environment variable, or supply ORBIT_AGENT_API_KEY below.
ORBIT_AGENT_PROVIDER=
ORBIT_AGENT_MODEL=
ORBIT_AGENT_API_KEY=

# Option B: a chat-completions-compatible endpoint. When set, this takes
# precedence over ORBIT_AGENT_PROVIDER. Set model and API key above as well.
# Include the API prefix, e.g. https://your-provider.example/v1 (not /chat/completions).
ORBIT_AGENT_BASE_URL=
ORBIT_AGENT_CONTEXT_WINDOW=32768
ORBIT_AGENT_MAX_TOKENS=4096

# Option C: ORBIT_AGENT_PROVIDER=openai-codex + an exact SDK catalog model ID.
# Reads a ChatGPT login from CODEX_HOME/auth.json, default ~/.codex/auth.json.
# API key is not needed. Orbit never refreshes/writes back this login.
# Only file-based Codex credentials are supported; OS keyring is not read.
# CODEX_HOME=/absolute/path/to/your/codex-directory
